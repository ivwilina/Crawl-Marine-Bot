# HTTP server: JSON API only (no UI, no static files). It serves crawled data to
# soosky-marine-api. Bind loopback only; publish through a reverse proxy if it
# must be reachable. Set 0.0.0.0 only when the host firewall already restricts
# access.
HTTP_HOST=127.0.0.1
PORT=3000

# Required. The HTTP server refuses to start while this is empty. Callers send
# it as the X-API-Key header on GET /vessel/:id and every /watchlist route.
# Generate a random value per environment and inject it from the systemd
# EnvironmentFile — never commit a real key.
API_KEY=

# Legacy persistence for detail lookup/watchlist only. Do not point this at the
# Soosky Marine production MongoDB.
MONGODB_URI=mongodb://localhost:27017/crawlbot
REDIS_URL=
CACHE_TTL_MS=60000

# GET /vessel/:id serves an already-crawled record when it is enriched (has a
# ship type and a course, i.e. it came from a detail page rather than the map
# scan) and its position is younger than this. Older than this, it re-fetches
# from upstream. Raise it to cut upstream requests, lower it for fresher voyage
# data.
DETAILS_STORE_MAX_AGE_MS=1800000

# Data freshness. A latest position older than POSITION_STALE_AFTER_MS is never
# returned by the API and is deleted from latest_positions by the cleanup that
# runs every POSITION_CLEANUP_EVERY_MS. Vessel metadata and position history are
# kept. Both must be positive numbers or startup fails.
#
# MUST exceed one full scan cycle, or vessels are deleted before the next cycle
# reaches them again. A 760-tile world cycle at 4 tiles / 60s, with dense tiles
# subdividing down to 1 degree, takes roughly 15-30h — hence 72h here.
POSITION_STALE_AFTER_MS=259200000
POSITION_CLEANUP_EVERY_MS=3600000

# Optional VesselFinder detail polling for a small, explicit watchlist.
WATCHLIST=9811983
CRAWL_EVERY_MS=21600000
CRAWL_DELAY_MS=3000

# VesselFinder map scan. Each region is minLat,minLon,maxLat,maxLon; separate
# regions with semicolons. Start small and add coverage only after monitoring.
# LEAVE EMPTY to cover the whole world with a SCAN_TILE_DEG grid instead.
# Example below: US East Coast; United Kingdom; Norway.
SCAN_BBOX=24,-82,47,-66;49,-8,61,2;57,4,72,32

# World grid tile size in degrees. 9 gives exactly 760 tiles (19 latitude rows
# x 40 longitude columns, capped at +-84 deg where Web Mercator ends).
SCAN_TILE_DEG=9

# Pace. SCAN_CONCURRENCY tiles are fetched in parallel, then the scanner waits
# SCAN_CHUNK_DELAY_MS. 4 tiles / 60s averages one request every 15s. Raising
# concurrency or lowering the delay increases the request rate proportionally;
# neither bypasses source restrictions nor guarantees the source permits use.
SCAN_CONCURRENCY=4
SCAN_CHUNK_DELAY_MS=60000

# Write to the database once every SCAN_FLUSH_EVERY_TILES tiles instead of once
# per vessel. Larger batches mean fewer, bigger writes and a larger loss window
# if the process dies mid-cycle (at most this many tiles).
SCAN_FLUSH_EVERY_TILES=20

# One completed cycle over every tile is followed by this wait, then it repeats.
SCAN_INTERVAL_MS=21600000

SCAN_ZOOM=9
# A tile returning at least this many vessels is assumed truncated by mp2 and is
# split into 4 children, down to SCAN_MIN_TILE_DEG. From 9 deg that is 4 levels,
# so a dense tile can cost up to 341 requests.
SCAN_SUBDIVIDE_THRESHOLD=400
SCAN_MIN_TILE_DEG=1
SCAN_BLOCK_COOLDOWN_MS=43200000

# Optional metadata enrichment. STANDALONE worker: run it with `npm run enrich`.
# The HTTP server never starts it, so upstream request volume stays predictable.
# Keep it disabled (ENRICH_BATCH_SIZE=0) until the regional scan is stable,
# because it makes additional upstream requests.
ENRICH_BATCH_SIZE=0
ENRICH_DELAY_MS=3000
ENRICH_INTERVAL_MS=21600000
